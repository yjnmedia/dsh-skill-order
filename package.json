{
  "name": "dsh-skill-order",
  "version": "1.4.1",
  "description": "DSH 技能控制（别名技能管家）：分组排序、行内改名、导入本机目录或 zip，改完斜杠菜单立刻生效。",
  "type": "module",
  "license": "MIT",
  "author": "yjnmedia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjnmedia/dsh-skill-order.git"
  },
  "homepage": "https://github.com/yjnmedia/dsh-skill-order#readme",
  "bugs": {
    "url": "https://github.com/yjnmedia/dsh-skill-order/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/render-smoke.mjs && SMOKE_EN=1 node scripts/render-smoke.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills"
  ]
}
