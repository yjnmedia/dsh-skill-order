{
  "name": "dsh-skill-order",
  "version": "1.0.14",
  "description": "DSH 设置页拖拽排序技能：应用后同步改目录名与 SKILL.md 的 name，从而改变 / 菜单顺序。",
  "type": "module",
  "license": "MIT",
  "author": "yjnmedia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjnmedia/dsh-skill-order.git"
  },
  "homepage": "https://github.com/yjnmedia/dsh-skill-order#readme",
  "bugs": {
    "url": "https://github.com/yjnmedia/dsh-skill-order/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills"
  ]
}
